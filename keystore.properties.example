# 이 파일을 keystore.properties로 복사한 뒤 값을 채우면 릴리스 빌드에 서명이 붙습니다.
# keystore.properties와 .jks 파일은 저장소에 커밋하지 마세요(.gitignore에 등록되어 있습니다).
#
# 키스토어 생성:
#   keytool -genkeypair -v -keystore app-good-words-release.jks \
#     -alias app-good-words -keyalg RSA -keysize 2048 -validity 10000
#
# 이 키스토어를 잃어버리면 같은 앱으로 업데이트를 올릴 수 없습니다. 따로 백업하세요.

storeFile=../app-good-words-release.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=app-good-words
keyPassword=여기에_키_비밀번호
