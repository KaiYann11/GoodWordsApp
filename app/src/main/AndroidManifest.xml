<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        설정의 "앱 업데이트"가 받아 둔 설치 파일을 안드로이드 설치 화면으로 넘기는 데 씁니다.
        앱이 직접 설치하는 권한이 아닙니다 — 설치 여부는 사용자가 그 화면에서 정하고,
        처음에는 "이 출처의 앱 설치 허용"을 한 번 더 물어봅니다.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 할 일 알람은 사용자가 정한 시각에 울려야 해서 정확한 알람이 필요합니다. 오늘의 한마디도 정한 주기에
         같은 권한으로 깨웁니다. Android 12+에서는 사용자가 시스템 설정에서 한 번 켜 줘야 하고, 앱이 그 화면으로 안내합니다. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+에서는 위 권한이 처음부터 꺼져 있어, 켜러 가지 않으면 한마디·할 일 알람이 몇 분씩 밀렸습니다.
         알람 앱처럼 설치만으로 허용되는 이쪽을 함께 둡니다. Play 스토어는 알람·달력 앱에만 이것을 허락하지만,
         이 앱은 서버에서 직접 받아 깔므로 그 심사를 거치지 않습니다. 스토어에 올리게 되면 다시 봐야 합니다. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 재부팅하면 AlarmManager 예약이 모두 사라지므로 다시 걸어야 합니다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AppGoodWordsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AppGoodWords">
        <!--
          만든 글귀 카드 이미지를 다른 앱에 넘기려면 파일 자체가 아니라 content:// 주소로 줘야 합니다.
          내보내지 않고(exported=false), 받는 앱에만 한 번씩 읽기 권한을 넘깁니다.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".work.NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".work.TodoAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 오늘의 한마디 알람. 재부팅·업데이트로 사라진 알람과, 정확한 알람 권한을 켰을 때 다시 겁니다. -->
        <receiver
            android:name=".work.DailyCoachAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.QuoteWidgetReceiver"
            android:exported="true"
            android:label="@string/quote_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quote_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.RoutineWidgetReceiver"
            android:exported="true"
            android:label="@string/routine_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/routine_widget_info" />
        </receiver>

        <!--
            자판이 올라오면 창을 밀지 말고 줄입니다. 미는 방식(adjustPan)에서는 화면 위쪽이
            통째로 밀려 나가, 글을 쓰는 동안 제목 줄과 저장 버튼이 화면 밖으로 사라집니다.
            가장자리까지 그리는 창이라 줄어든 자리는 화면이 imePadding으로 비켜 줍니다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            공유에서 이 앱을 고르면 화면 없이 바로 담습니다.
            보이는 화면이 없어 NoDisplay 테마를 쓰고, 최근 목록에도 남기지 않습니다.
            연속 공유가 닫히는 화면에 합쳐져 빠지지 않도록 요청마다 새 작업으로 엽니다.
            담는 화면을 다시 거치게 하려면 이 거르개를 MainActivity로 되돌리면 됩니다.
        -->
        <activity
            android:name=".ShareTargetActivity"
            android:exported="true"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/share_target_label"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
