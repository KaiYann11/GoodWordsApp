<?xml version="1.0" encoding="utf-8"?>
<!--
  접속 키와 개인 기록을 보내는 통신은 HTTPS만 허용합니다.
  사용자가 설치한 CA는 신뢰하지 않습니다(시스템 CA만 사용).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
