<?xml version="1.0" encoding="utf-8"?>
<!--
  런처 아이콘의 앞면.

  앱의 한가운데는 "남겨 둔 좋은 글귀"입니다. 그래서 따옴표 하나만 크게 둡니다.
  전에는 해·카드 두 장·책갈피·따옴표·밑줄이 다 들어 있었는데, 런처에서 48dp로 줄면
  무엇인지 알아볼 수 없게 뭉갭니다. 작게 보이는 것이 이 그림의 본래 크기입니다.

  적응형 아이콘은 108 화폭 가운데 지름 66(반지름 33) 원만 항상 보입니다.
  런처마다 원·둥근 사각으로 다르게 잘라내므로, 모든 그림을 그 원 안에 둡니다.

  오른쪽 따옴표만 다른 색인 이유는, 같은 색 두 개는 덩어리로 붙어 보이기 때문입니다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      왼쪽 따옴표: 동그라미와 꼬리.
      꼬리는 왼쪽 아래로 내려갑니다. 오른쪽으로 흘리면 따옴표가 아니라 물방울로 보입니다.
    -->
    <path
        android:fillColor="#FFF6E4"
        android:pathData="M31.5,45a9.5,9.5 0 1,0 19,0a9.5,9.5 0 1,0 -19,0Z" />
    <path
        android:fillColor="#FFF6E4"
        android:pathData="M50.5,46C50.5,58 44.5,64 38,67L34,58C40,56 43.5,52 43.5,46Z" />

    <!-- 오른쪽 따옴표. -->
    <path
        android:fillColor="#FF9E7A"
        android:pathData="M57.5,45a9.5,9.5 0 1,0 19,0a9.5,9.5 0 1,0 -19,0Z" />
    <path
        android:fillColor="#FF9E7A"
        android:pathData="M76.5,46C76.5,58 70.5,64 64,67L60,58C66,56 69.5,52 69.5,46Z" />

    <!-- 글줄 하나. 따옴표만 두면 위쪽으로 쏠려서 아래를 받쳐 줍니다. -->
    <path
        android:fillColor="#FFF6E4"
        android:fillAlpha="0.5"
        android:pathData="M40.5,74h27a2.5,2.5 0 0,1 0,5h-27a2.5,2.5 0 0,1 0,-5Z" />
</vector>
